# PostgreSQL connection string (required)
# Matches doc/docker-compose.yml (postgres container on localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mugiko

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Stream consumption
SUBTITLE_STREAM=subtitle_queue
CONSUMER_GROUP=subtitle-workers
# CONSUMER_NAME defaults to worker-<user>-<pid>
# CONSUMER_NAME=worker-1

# How long XREADGROUP blocks waiting for new messages (milliseconds).
# Keep this non-zero so idle workers periodically reclaim stale pending jobs.
READ_BLOCK_MS=5000
# Messages pending longer than this are reclaimed after a crash
CLAIM_IDLE_MS=300000

# Redis socket timeout (seconds). Defaults to max(10, READ_BLOCK_MS/1000 + 5)
# so a blocking XREAD races the socket timeout instead of hitting redis-py's
# default 5 second timeout.
# REDIS_SOCKET_TIMEOUT_SECONDS=10

# After a Redis socket timeout, scan PostgreSQL for subtitle jobs stuck in
# queued/processing older than this many seconds and retry them. "failed" rows
# are left terminal and are not retried.
RECOVERY_STALE_SECONDS=300
# How many stale jobs to recover per batch.
RECOVERY_BATCH_SIZE=10

# Subtitle status stream consumed by the API's SSE endpoint.
STATUS_STREAM=subtitle_status
STATUS_STREAM_MAXLEN=10000

# NVIDIA NIM LLM worker.
# The key file has one API key per line and is used round-robin.
NVIDIA_API_KEYS_FILE=nim.txt
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# yt-dlp cookies file (Netscape format) for YouTube subtitle downloads.
# Mount cookies.txt into the subtitle-worker container at /app/cookies.txt.
# YTDLP_COOKIES_FILE=/app/cookies.txt

# Groq API key file (one key per line) for Groq Whisper subtitle generation.
# Mount groq.txt into the subtitle-worker container at /app/groq.txt.
# GROQ_API_KEYS_FILE=/app/groq.txt
NVIDIA_NIM_TEMPERATURE=0.2
NVIDIA_NIM_MAX_TOKENS=4096
NVIDIA_NIM_TIMEOUT_SECONDS=120
LLM_POLL_INTERVAL_MS=2000
LLM_STALE_PROCESSING_SECONDS=900
# LLM status stream consumed by the API's SSE endpoint.
LLM_STATUS_STREAM=llm_status
LLM_STATUS_STREAM_MAXLEN=10000
