# From doc/docker-compose.yml (postgres:15-alpine, redis:7-alpine)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mugiko
REDIS_URL=redis://localhost:6379/0

# Stream consumption
SUBTITLE_STREAM=subtitle_queue
CONSUMER_GROUP=subtitle-workers
# CONSUMER_NAME=worker-1

# Redis cache for crawled subtitles (yt-dlp provider)
# TTL in seconds; default 7 days
SUBTITLE_CACHE_TTL_SECONDS=604800

# Subtitle status stream consumed by the API SSE endpoint
STATUS_STREAM=subtitle_status
STATUS_STREAM_MAXLEN=10000

# NVIDIA NIM LLM worker (keys are mounted read-only from nim.txt)
NVIDIA_API_KEYS_FILE=nim.txt
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_NIM_TEMPERATURE=0.2
NVIDIA_NIM_MAX_TOKENS=4096
NVIDIA_NIM_TIMEOUT_SECONDS=120
LLM_POLL_INTERVAL_MS=2000
LLM_STALE_PROCESSING_SECONDS=900

# LLM job status stream consumed by the API SSE endpoint
LLM_STATUS_STREAM=llm_status
LLM_STATUS_STREAM_MAXLEN=10000
